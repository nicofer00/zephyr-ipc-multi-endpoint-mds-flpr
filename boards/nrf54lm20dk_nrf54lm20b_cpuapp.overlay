/ {
	chosen {
		/*
		 * App printk/LOG → debugger VCOM (uart20).
		 * USB CDC0 → shell
		 * USB CDC1 → FLPR log forward (see flpr_ipc.c)
		 * USB CDC2 → MCUmgr UART SMP DFU (CONFIG_MCUMGR_TRANSPORT_UART)
		 *
		 * Stock cdc_acm_serial boot helper only registers chosen CDCs;
		 * this sample uses src/usb_cdc_triple.c so CDC1 is registered
		 * even though it is not a chosen backend.
		 */
		zephyr,console = &uart20;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,uart-mcumgr = &cdc_acm_uart2;
	};

	soc {
		reserved-memory {
			#address-cells = <1>;
			#size-cells = <1>;

			sram_rx: memory@20047c00 {
				reg = <0x20047c00 0x8000>;
			};

			sram_tx: memory@2004fc00 {
				reg = <0x2004fc00 0x8000>;
			};
		};
	};

	ipc {
		ipc0: ipc0 {
			compatible = "zephyr,ipc-icmsg-me-initiator";
			dcache-alignment = <32>;
			tx-region = <&sram_tx>;
			rx-region = <&sram_rx>;
			mboxes = <&cpuapp_vevif_rx 20>, <&cpuapp_vevif_tx 21>;
			mbox-names = "rx", "tx";
			status = "okay";
		};
	};
};

&cpuapp_vevif_rx {
	status = "okay";
};

&cpuapp_vevif_tx {
	status = "okay";
};

&uart20 {
	status = "okay";
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "CDC_ACM_0";
	};

	cdc_acm_uart1: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
		label = "CDC_ACM_1";
	};

	cdc_acm_uart2: cdc_acm_uart2 {
		compatible = "zephyr,cdc-acm-uart";
		label = "CDC_ACM_2";
	};
};

/* SPI00 MX25R64 for shell CLI only — OTA secondary stays on internal RRAM. */
&mx25r64 {
	status = "okay";
	spi-max-frequency = <8000000>;
};
